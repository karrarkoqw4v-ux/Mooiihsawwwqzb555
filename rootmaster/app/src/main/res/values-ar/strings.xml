    <string name="cancel">إلغاء</string>
    <string name="procedure">الخطوات</string>
    <string name="procedure_note">الخطوات المعلّمة يدوي تتم خارج هذا التطبيق. التطبيق لا يستطيع تنفيذها ولا يدّعي ذلك.</string>
