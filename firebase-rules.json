{
  "rules": {
    "users": {
      ".indexOn": [
        "username",
        "first",
        "last"
      ],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/) && root.child('usernames/' + newData.val()).val() === auth.uid"
        },
        "first": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "last": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length < 400000"
        },
        "cover": {
          ".validate": "newData.isString() && newData.val().length < 400000"
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.val() === auth.uid"
      }
    },
    "muted": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        ".indexOn": [
          "t"
        ],
        "$msgId": {
          ".write": "auth != null && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
          ".validate": "newData.child('from').val() === auth.uid && newData.child('t').val() === now",
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $peer)"
        }
      }
    },
    "stories": {
      ".read": "auth != null",
      "$uid": {
        "$sid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "blobs": {
      "$chatId": {
        "$id": {
          ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
          ".write": "auth != null && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
          ".validate": "newData.isString() && newData.val().length < 1500000"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('caller').val() === auth.uid || data.child('callee').val() === auth.uid)",
        ".write": "auth != null && (data.exists() ? (data.child('caller').val() === auth.uid || data.child('callee').val() === auth.uid) : newData.child('caller').val() === auth.uid)"
      }
    },
    "callInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || newData.child('from').val() === auth.uid || data.child('from').val() === auth.uid)"
        }
      }
    },
    "privacy": {
      "$owner": {
        "$peer": {
          ".read": "auth != null && (auth.uid === $owner || auth.uid === $peer)",
          ".write": "auth != null && auth.uid === $owner"
        }
      }
    }
  }
}