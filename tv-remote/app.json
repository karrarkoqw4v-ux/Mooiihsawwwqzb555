{
  "expo": {
    "name": "ريموت التلفزيون",
    "slug": "tv-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151517",
    "android": {
      "package": "com.tvremote.app",
      "adaptiveIcon": {
        "backgroundColor": "#151517"
      },
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.tvremote.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
